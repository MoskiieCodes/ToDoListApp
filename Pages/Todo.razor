@page "/todo"
@using TodoAppBlazor.Models
@using TodoAppBlazor.Services
@inject TaskApiService TaskApi

<h1 class="header">CODING CHALLENGE:<br />BUILD A TO-DO LIST APPLICATION</h1>

<div class="form-card">
    <h3>New Task</h3>
    <input placeholder="Title" @bind="title" />
    <textarea placeholder="Description" @bind="description"></textarea>
    <div class="row">
        <input type="date" @bind="dueDate" />
        <select @bind="priority">
            <option>Low</option>
            <option selected>Medium</option>
            <option>High</option>
        </select>
        <button @onclick="AddTask">@addButtonLabel</button>
    </div>
</div>

<div class="filter-header">
    <h3>Tasks</h3>
    <select @bind="filter">
        <option value="all">All</option>
        <option value="pending">Pending</option>
        <option value="completed">Completed</option>
    </select>
</div>

@foreach (var task in FilteredTasks)
{
    <div class="task-card @(task.IsCompleted ? "completed-task" : "")">
        <div>
            <strong>@task.Title</strong><br />
            <span>@task.Description</span>
        </div>
        <div class="badges">
            <input type="checkbox" @onchange="() => ToggleComplete(task.Id)" checked="@task.IsCompleted" />
            <span class="badge date">@task.DueDate.ToString("MM-dd")</span>
            <span class="badge priority @task.Priority.ToLower()">@task.Priority</span>
            <button class="icon-btn edit" @onclick="() => Edit(task)">✏️</button>
            <button class="icon-btn delete" @onclick="() => Delete(task.Id)">🗑️</button>
        </div>
    </div>
}

@code {
    private string title = "";
    private string description = "";
    private DateTime dueDate = DateTime.Today;
    private string priority = "Medium";
    private string addButtonLabel = "Add Task";
    private int? editingId = null;
    private string filter = "pending";
    private List<TaskItem> tasks = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tasks = await TaskApi.GetAllTasksAsync();
            Console.WriteLine($"Loaded {tasks.Count} tasks.");
        }
        catch (Exception ex)
        {
           Console.WriteLine($"OnInit ERROR: {ex.Message}");
        }
    }

    private async Task AddTask()
{
    if (string.IsNullOrWhiteSpace(title)) return;

    try
    {
        if (editingId == null)
        {
            var task = new TaskItem
            {
                Title = title,
                Description = description,
                DueDate = dueDate,
                Priority = priority,
                IsCompleted = false
            };
            await TaskApi.AddTaskAsync(task);
        }
        else
        {
            var task = tasks.FirstOrDefault(t => t.Id == editingId);
            if (task != null)
            {
                task.Title = title;
                task.Description = description;
                task.DueDate = dueDate;
                task.Priority = priority;
                await TaskApi.AddTaskAsync(task); // placeholder for update
            }
            addButtonLabel = "Add Task";
            editingId = null;
        }

        title = description = "";
        dueDate = DateTime.Today;
        tasks = await TaskApi.GetAllTasksAsync();

        Console.WriteLine("Task added and list refreshed.");
    }
    catch (Exception ex)
    {
        Console.WriteLine($"AddTask ERROR: {ex.Message}");
    }
}

    private async Task Delete(int id)
    {
        await TaskApi.DeleteTaskAsync(id);
        tasks = await TaskApi.GetAllTasksAsync();
    }

    private void Edit(TaskItem task)
    {
        title = task.Title;
        description = task.Description;
        dueDate = task.DueDate;
        priority = task.Priority;
        editingId = task.Id;
        addButtonLabel = "Save Changes";
    }

    private async Task ToggleComplete(int id)
    {
        await TaskApi.MarkCompletedAsync(id);
        tasks = await TaskApi.GetAllTasksAsync();
    }

    private List<TaskItem> FilteredTasks => filter switch
    {
        "completed" => tasks.Where(t => t.IsCompleted).ToList(),
        "pending" => tasks.Where(t => !t.IsCompleted).ToList(),
        _ => tasks
    };
}
